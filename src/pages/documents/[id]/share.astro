---
import Icon from '@/components/ui/Icon.astro';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { canManageDocument, describeAccess } from '@/lib/documents/access';
import { formatTimestamp } from '@/lib/documents/format';
import { isDocumentId } from '@/lib/documents/ids';
import { shareNotice } from '@/lib/documents/messages';
import { getDocument, listCollaborators, listInvitations } from '@/lib/documents/repository';
import {
  GENERAL_ACCESS,
  GENERAL_ACCESS_LABELS,
  generalAccessFor,
  INVITE_ROLES,
  LINK_ROLE_LABELS,
  PUBLISH_LABELS,
  ROLE_HINTS,
  ROLE_LABELS,
  sortCollaborators,
} from '@/lib/documents/sharing';

export const prerender = false;

const { user, supabase } = Astro.locals;
const id = Astro.params.id ?? '';

if (!user || !supabase) return Astro.redirect('/login?next=/dashboard');
if (!isDocumentId(id)) return Astro.redirect('/dashboard?error=not_found');

const document = await getDocument(supabase, user.id, id);
if (!document) return Astro.redirect('/dashboard?error=not_found');

const manageable = canManageDocument(document.role);
const params = Astro.url.searchParams;
const notice = shareNotice({
  error: params.get('error'),
  invited: params.get('invited'),
  added: params.get('added'),
  yours: params.get('yours'),
  invalid: params.get('invalid'),
  role: params.get('role'),
  removed: params.get('removed'),
  link: params.get('link'),
  visibility: params.get('visibility'),
});

const action = `/documents/${encodeURIComponent(document.id)}/share`;

// Non-managers skip these queries entirely - RLS would reject them anyway.
const collaborators = manageable
  ? sortCollaborators(await listCollaborators(supabase, document.id))
  : [];
const invitations = manageable
  ? (await listInvitations(supabase, document.id)).filter((entry) => entry.acceptedAt === null)
  : [];
const origin = Astro.url.origin;
const roleOptions = ['reader', 'editor'] as const;

// The address to hand out always opens the editor: the reach and the link role
// decide what the holder may do there. The published read-only page under
// `/d/<slug>` remains for search engines, not for this field.
const shareAddress = `${origin}/?doc=${encodeURIComponent(document.id)}`;
---

<AccountLayout
  title={document.title}
  description={`Who can reach this document · you are ${describeAccess(document.role).toLowerCase()}`}
  current="dashboard"
>
  {notice && (
    <p
      class:list={[
        'mb-6 rounded-lg border px-3 py-2 text-xs',
        notice.tone === 'error'
          ? 'border-red-900 bg-red-950/40 text-red-300'
          : 'border-emerald-900 bg-emerald-950/30 text-emerald-300',
      ]}
    >
      {notice.message}
    </p>
  )}

  <div class="mb-6 flex flex-wrap items-center gap-2">
    <a href={`/?doc=${encodeURIComponent(document.id)}`} class="hb on">
      <Icon name="lucide:terminal" />
      Open in the editor
    </a>
    <a href={`/documents/${encodeURIComponent(document.id)}/history`} class="hb">
      <Icon name="lucide:history" />
      History
    </a>
    <a href="/dashboard" class="hb">
      <Icon name="lucide:arrow-left" />
      All documents
    </a>
  </div>

  {!manageable ? (
    <section class="rounded-xl border border-dashed border-neutral-800 p-6 text-center">
      <Icon name="lucide:lock" size={20} class="mx-auto text-neutral-600" />
      <h2 class="mt-3 text-sm font-medium text-neutral-200">
        Only the owner decides who has access
      </h2>
      <p class="mx-auto mt-1 max-w-md text-xs leading-relaxed text-neutral-500">
        Your role here is {describeAccess(document.role).toLowerCase()}. You can read the document
        and its history, and keep editing if that is your role - sharing stays with the owner.
      </p>
    </section>
  ) : (
    <>
      <section class="rounded-xl border border-neutral-800 bg-neutral-950/60 p-4">
        <h2 class="flex items-center gap-2 text-xs font-medium text-neutral-300">
          <Icon name="lucide:user-plus" size={14} />
          Invite by email
        </h2>
        <form method="POST" action={`${action}/invite`} class="mt-3 space-y-2">
          <textarea
            name="emails"
            rows="2"
            required
            placeholder="ana@example.com, luis@example.com"
            aria-label="Email addresses to invite"
            class="w-full rounded-lg border border-neutral-800 bg-black px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-600 focus:border-neutral-600 focus:outline-none"
          ></textarea>
          <div class="flex flex-wrap items-center gap-2">
            <select
              name="role"
              aria-label="Role for the invited addresses"
              class="rounded-lg border border-neutral-800 bg-black px-2 py-1.5 text-xs text-neutral-200"
            >
              <option value="reader">Can view</option>
              <option value="editor">Can edit</option>
            </select>
            <button type="submit" class="hb on">
              <Icon name="lucide:send" />
              Send invitation
            </button>
          </div>
        </form>
      </section>

      <section class="mt-6">
        <h2 class="flex items-center gap-2 text-xs font-medium text-neutral-400">
          <Icon name="lucide:users" size={14} />
          People with access
          <span class="text-neutral-600">({collaborators.length + 1})</span>
        </h2>

        <ul class="mt-3 space-y-2">
          <li class="rounded-xl border border-neutral-800 bg-neutral-950/60 p-3">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="text-sm text-neutral-100">
                  {user.email ?? 'You'}
                  <span class="ml-1 text-[11px] text-neutral-500">(you)</span>
                </p>
                <p class="mt-0.5 text-[11px] text-neutral-500">
                  {ROLE_LABELS.owner} · cannot be removed
                </p>
              </div>
            </div>
          </li>

          {collaborators.map((collaborator) => (
            <li class="rounded-xl border border-neutral-800 bg-neutral-950/60 p-3">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-sm text-neutral-100">{collaborator.name}</p>
                  <p class="mt-0.5 text-[11px] text-neutral-500">
                    @{collaborator.username} · added {formatTimestamp(collaborator.addedAt)}
                  </p>
                </div>

                <div class="flex shrink-0 flex-wrap items-center gap-1">
                  <form
                    method="POST"
                    action={`${action}/collaborator`}
                    class="flex items-center gap-1"
                  >
                    <input type="hidden" name="action" value="role" />
                    <input type="hidden" name="user" value={collaborator.userId} />
                    <select
                      name="role"
                      aria-label={`Role for ${collaborator.name}`}
                      class="rounded-lg border border-neutral-800 bg-black px-2 py-1.5 text-xs text-neutral-200"
                    >
                      {roleOptions.map((role) => (
                        <option value={role} selected={collaborator.role === role}>
                          {ROLE_LABELS[role]}
                        </option>
                      ))}
                    </select>
                    <div class="flex justify-end pt-1">
                      <button type="submit" class="hb">
                        Save
                      </button>
                    </div>
                  </form>

                  <form
                    method="POST"
                    action={`${action}/collaborator`}
                    data-confirm={`Remove ${collaborator.name}? They immediately lose access to this document.`}
                    data-confirm-title={`Remove ${collaborator.name}?`}
                    data-confirm-label="Remove"
                    data-confirm-danger
                  >
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="user" value={collaborator.userId} />
                    <button
                      type="submit"
                      class="hb danger"
                      title="Remove access"
                      aria-label={`Remove ${collaborator.name}`}
                    >
                      <Icon name="lucide:user-minus" />
                    </button>
                  </form>
                </div>
              </div>
            </li>
          ))}
        </ul>

        {invitations.length > 0 && (
          <div class="mt-4">
            <h3 class="text-[11px] font-medium text-neutral-400">Waiting for an account</h3>
            <ul class="mt-2 space-y-2">
              {invitations.map((invitation) => (
                <li class="rounded-xl border border-dashed border-neutral-800 p-3">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="min-w-0">
                      <p class="truncate text-sm text-neutral-200">{invitation.email}</p>
                      <p class="mt-0.5 text-[11px] text-neutral-500">
                        {ROLE_LABELS[invitation.role]} when they sign up · invited{' '}
                        {formatTimestamp(invitation.createdAt)}
                      </p>
                    </div>
                    <form
                      method="POST"
                      action={`${action}/invitation`}
                      data-confirm={`Revoke the invitation for ${invitation.email}? They will no longer be able to claim access with it.`}
                      data-confirm-title="Revoke this invitation?"
                      data-confirm-label="Revoke"
                      data-confirm-danger
                    >
                      <input type="hidden" name="invitation" value={invitation.id} />
                      <button type="submit" class="hb danger">
                        <Icon name="lucide:x" />
                        Revoke
                      </button>
                    </form>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <section class="mt-8 rounded-xl border border-neutral-800 bg-neutral-950/60 p-4">
        <h2 class="flex items-center gap-2 text-xs font-medium text-neutral-300">
          <Icon name="lucide:link" size={14} />
          Share by link
        </h2>

        <div class="mt-3 flex flex-wrap items-center gap-1">
          <input
            type="text"
            readonly
            value={shareAddress}
            aria-label="Address to share"
            class="min-w-0 flex-1 rounded-lg border border-neutral-800 bg-black px-2 py-1.5 font-mono text-[11px] text-neutral-300"
          />
          <button
            type="button"
            class="hb"
            data-copy={shareAddress}
            title="Copy link"
            aria-label="Copy link"
          >
            <Icon name="lucide:copy" />
            Copy
          </button>
        </div>
        <p class="mt-2 text-[11px] leading-relaxed text-neutral-500">
          This always opens the document in the editor. The reach and the role the link grants
          decide what the holder may do there - someone without an account still needs the document
          to be reachable by link.
        </p>
      </section>

      <section class="mt-8 rounded-xl border border-neutral-800 bg-neutral-950/60 p-4">
        <h2 class="flex items-center gap-2 text-xs font-medium text-neutral-300">
          <Icon name="lucide:eye" size={14} />
          Who can reach it
        </h2>

        <form method="POST" action={`${action}/visibility`} class="mt-3 space-y-2">
          {GENERAL_ACCESS.map((access) => (
            <label class="flex items-start gap-3 rounded-lg border border-neutral-800 p-3">
              <input
                type="radio"
                name="access"
                value={access}
                checked={generalAccessFor(document.visibility) === access}
                class="mt-0.5"
              />
              <span class="min-w-0">
                <span class="block text-sm text-neutral-100">
                  {GENERAL_ACCESS_LABELS[access].label}
                </span>
                <span class="mt-0.5 block text-[11px] leading-relaxed text-neutral-500">
                  {GENERAL_ACCESS_LABELS[access].hint}
                </span>
              </span>
            </label>
          ))}

          <div class="space-y-3 rounded-lg border border-neutral-800 p-3">
            <p class="text-[11px] font-medium tracking-wide text-neutral-400 uppercase">
              What the link gives
            </p>
            {INVITE_ROLES.map((role) => (
              <label class="flex items-start gap-3">
                <input
                  type="radio"
                  name="linkRole"
                  value={role}
                  checked={document.linkRole === role}
                  class="mt-0.5"
                />
                <span class="min-w-0">
                  <span class="block text-sm text-neutral-100">{LINK_ROLE_LABELS[role].label}</span>
                  <span class="mt-0.5 block text-[11px] leading-relaxed text-neutral-500">
                    {LINK_ROLE_LABELS[role].hint}
                  </span>
                </span>
              </label>
            ))}

            <label class="flex items-start gap-3 border-t border-neutral-800 pt-3">
              <input
                type="checkbox"
                name="published"
                checked={document.visibility === 'public'}
                class="mt-0.5"
              />
              <span class="min-w-0">
                <span class="block text-sm text-neutral-100">{PUBLISH_LABELS.label}</span>
                <span class="mt-0.5 block text-[11px] leading-relaxed text-neutral-500">
                  {PUBLISH_LABELS.hint}
                </span>
              </span>
            </label>
          </div>

          <div class="flex justify-end pt-1">
            <button type="submit" class="hb on">
              Save
            </button>
          </div>
        </form>
      </section>

      <p class="mt-6 text-[11px] leading-relaxed text-neutral-600">
        Roles: {ROLE_HINTS.reader} {ROLE_HINTS.editor} Everything here is enforced by row level
        security in Postgres, not by this page.
      </p>
    </>
  )}
</AccountLayout>

<script>
  import { initConfirmForms } from '@/lib/app/confirmDialog';

  initConfirmForms();

  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', () => {
      const value = button.dataset.copy ?? '';
      const label = button.textContent ?? '';
      void navigator.clipboard
        ?.writeText(value)
        .then(() => {
          button.textContent = 'Copied';
          window.setTimeout(() => {
            button.textContent = label;
          }, 1500);
        })
        .catch(() => {
          /* Clipboard blocked: the field next to the button still holds the URL. */
        });
    });
  }
</script>
