---
import Avatar from '@/components/ui/Avatar.astro';
import Icon from '@/components/ui/Icon.astro';
import AccountLayout from '@/layouts/AccountLayout.astro';
import { toAccountSummary } from '@/lib/auth/account';
import { profileNotice } from '@/lib/auth/messages';
import { DISPLAY_NAME_MAX_LENGTH, USERNAME_MAX_LENGTH } from '@/lib/auth/profile';

const account = toAccountSummary(Astro.locals.user, Astro.locals.profile);
if (!account) return Astro.redirect('/login?next=/settings');

const params = Astro.url.searchParams;
const notice = profileNotice({ saved: params.get('saved'), error: params.get('error') });

const NOTICE_TONES = {
  error: 'border-red-500/40 bg-red-500/10 text-red-200',
  success: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-200',
  info: 'border-sky-500/40 bg-sky-500/10 text-sky-200',
} as const;
---

<AccountLayout
  title="Profile"
  description="This name and handle identify you to the people you share documents with."
  current="settings"
>
  <form method="POST" action="/settings/profile" class="space-y-5">
    <div class="flex items-center gap-4">
      <Avatar name={account.displayName} seed={account.toneSeed} size="lg" />
      <p class="text-xs leading-relaxed text-neutral-500">
        Initials only — no profile picture to upload. The colour is derived from your account id.
      </p>
    </div>

    {notice && (
      <p
        class:list={[
          'rounded-lg border px-3 py-2 text-xs leading-relaxed',
          NOTICE_TONES[notice.tone],
        ]}
        role={notice.tone === 'error' ? 'alert' : 'status'}
      >
        {notice.message}
      </p>
    )}

    <div>
      <label for="display_name" class="block text-xs font-medium text-neutral-400">
        Display name
      </label>
      <input
        id="display_name"
        name="display_name"
        type="text"
        required
        maxlength={DISPLAY_NAME_MAX_LENGTH}
        autocomplete="name"
        value={account.displayName}
        class="mt-1.5 w-full rounded-lg border border-neutral-800 bg-neutral-950 px-3 py-2 text-sm text-neutral-100 focus:border-neutral-600 focus:outline-none"
      />
    </div>

    <div>
      <label for="username" class="block text-xs font-medium text-neutral-400">
        Username
      </label>
      <div class="mt-1.5 flex items-center rounded-lg border border-neutral-800 bg-neutral-950 focus-within:border-neutral-600">
        <span class="pl-3 text-sm text-neutral-500">@</span>
        <input
          id="username"
          name="username"
          type="text"
          required
          minlength="3"
          maxlength={USERNAME_MAX_LENGTH}
          pattern="[a-z0-9_]+"
          autocomplete="username"
          spellcheck="false"
          value={account.username}
          class="w-full bg-transparent px-2 py-2 text-sm text-neutral-100 focus:outline-none"
        />
      </div>
      <p class="mt-1.5 text-[11px] text-neutral-500">
        3–30 characters: lowercase letters, numbers and underscores.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="submit"
        class="rounded-lg bg-white px-3 py-2 text-sm font-medium text-black hover:bg-neutral-200"
      >
        Save changes
      </button>
      <a href="/dashboard" class="hb">
        Cancel
      </a>
    </div>
  </form>

  <section class="mt-10 border-t border-neutral-800 pt-6">
    <h2 class="text-xs font-medium text-neutral-300">Account</h2>
    <dl class="mt-3 grid gap-3 text-xs sm:grid-cols-2">
      <div>
        <dt class="text-neutral-500">Email</dt>
        <dd class="mt-0.5 break-all text-neutral-200">{account.email}</dd>
      </div>
      <div>
        <dt class="text-neutral-500">User id</dt>
        <dd class="mt-0.5 break-all font-mono text-[11px] text-neutral-400">{account.id}</dd>
      </div>
    </dl>

    <form method="POST" action="/auth/signout" class="mt-5">
      <input type="hidden" name="next" value="/" />
      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-lg border border-neutral-800 px-3 py-2 text-xs text-neutral-300 hover:border-red-500/40 hover:text-red-300"
      >
        <Icon name="log-out" size={14} />
        Sign out of this browser
      </button>
    </form>
  </section>
</AccountLayout>
