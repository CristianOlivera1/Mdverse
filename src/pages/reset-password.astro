---
import AbuseControls from '@/components/auth/AbuseControls.astro';
import AuthShell from '@/components/auth/AuthShell.astro';
import PasswordField from '@/components/auth/PasswordField.astro';
import { authNotice } from '@/lib/auth/messages';

const params = Astro.url.searchParams;
const notice = authNotice({ error: params.get('error') });
const email = Astro.locals.user?.email ?? '';
---

<AuthShell
  title="New password · Mdverse"
  heading="Choose a new password"
  subtitle={email ? `You are signed in as ${email}.` : 'You are signed in.'}
  notice={notice}
>
  <form method="POST" action="/auth/password/update" class="space-y-3">
    <AbuseControls />
    <PasswordField id="password" autocomplete="new-password" label="New password" />
    <PasswordField
      id="password-confirm"
      name="confirm_password"
      autocomplete="new-password"
      label="Confirm new password"
      matches="password"
      hint={null}
    />
    <button
      type="submit"
      class="w-full rounded-lg bg-white px-3 py-2 text-sm font-medium text-black hover:bg-neutral-200"
    >
      Update password
    </button>
  </form>

  <p class="mt-8 text-center text-xs text-neutral-500">
    <a href="/settings" class="text-neutral-200 hover:text-white">
      Back to your profile
    </a>
  </p>
</AuthShell>
