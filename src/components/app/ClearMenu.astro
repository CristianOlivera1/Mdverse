---
import Icon from '../ui/Icon.astro';
---

<div>
  <button
    type="button"
    class="hb danger"
    data-menu="clear"
    aria-haspopup="true"
    aria-expanded="false"
    title="Clear"
    aria-label="Clear"
  >
    <Icon name="lucide:eraser" />
  </button>
  <div class="pop" data-pop="clear" hidden>
    <button type="button" class="mi danger" data-command="clear-active">
      <Icon name="lucide:eraser" />
      Clear active document
    </button>
    <button type="button" class="mi danger" data-command="clear-all">
      <Icon name="lucide:trash" />
      Clear all documents
    </button>
  </div>
</div>
