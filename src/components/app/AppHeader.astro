---
import Icon from '../ui/Icon.astro';
import DocumentTabs from './DocumentTabs.astro';
import CollaborateDialog from './CollaborateDialog.astro';
import PresenceBar from './PresenceBar.astro';
import ExportMenu from './ExportMenu.astro';
import ViewMenu from './ViewMenu.astro';
import ClearMenu from './ClearMenu.astro';
import AccountMenu from '../auth/AccountMenu.astro';
---

<header class="flex items-center justify-between h-12 px-2 sm:px-3 border-b border-neutral-800 shrink-0 gap-1.5 sm:gap-3 select-none">
  <div class="flex items-center gap-1.5 sm:gap-3 min-w-0 z-10">
    <a href="/" class="max-sm:hidden flex items-center shrink-0" aria-label="Mdverse Home">
      <img
        src="/logo-calligraphy.svg"
        alt="Mdverse logo"
        class="h-7 w-auto"
        width="136"
        height="33"
      />
    </a>
    <span class="sep max-sm:hidden"></span>

    <!-- Tab strip scrolls internally (overflow-x-auto + no-sb in DocumentTabs);
      the header itself must stay overflow-visible: .pop panels are
      position:fixed and positioned by JS (see src/lib/app/menus.ts openMenu). -->
    <DocumentTabs />

    <div class="seg m-tabs shrink-0" role="group" aria-label="Visible panel">
      <button type="button" class="hb" data-command="panel-code" title="Code">
        <Icon name="lucide:code-xml" />
        <span class="hidden sm:inline">Code</span>
      </button>
      <button type="button" class="hb" data-command="panel-preview" title="Preview">
        <Icon name="lucide:eye" />
        <span class="hidden sm:inline">Preview</span>
      </button>
    </div>
  </div>

  <div class="relative flex items-center flex-nowrap h-full gap-1 sm:gap-1.5 shrink-0 z-10 pl-2 sm:pl-6">
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
      <img
        src="/images/bg-header.avif"
        alt=""
        class="w-full h-full object-cover opacity-90 mask-b-from-80% mask-b-to-99%"
      />
    </div>

    <!-- Tradeoff: popout/Export/View/Clear stay hidden below md to keep the
      360px layout collision-free; the md:hidden overflow menu below
      re-exposes the same four actions there. Desktop placement is unchanged.
      All remaining triggers are icon-only below lg (hidden lg:inline labels),
      and .pop panels are position:fixed so nothing here clips them. -->
    <div class="flex items-center gap-1 max-md:hidden">
      <button
        type="button"
        class="hb"
        data-command="popout"
        title="Open the preview in another tab"
        aria-label="Open preview in another tab"
      >
        <Icon name="lucide:external-link" />
        <span class="hidden lg:inline">Preview</span>
      </button>
      <ExportMenu />
      <ViewMenu />
      <ClearMenu />
    </div>

    <!-- Mobile overflow (below md only): the popout/Export/View/Clear group
      above is max-md:hidden, so this md:hidden trigger re-exposes the same
      four actions. Inner menus reuse the desktop components with suffixed
      names (export-m/view-m/clear-m) — data-menu/data-pop names must stay
      unique because menus.ts triggerFor resolves the FIRST match in the
      document. The popout button is a bare data-command, so duplicating it
      is free. Opening an inner menu closes this outer panel via closeMenus:
      one level at a time by design, not fought here. -->
    <div class="md:hidden">
      <button
        type="button"
        class="hb"
        data-menu="overflow"
        aria-haspopup="true"
        aria-expanded="false"
        title="More actions"
        aria-label="More actions"
      >
        <Icon name="lucide:ellipsis" />
      </button>
      <div class="pop" data-pop="overflow" hidden>
        <button type="button" class="mi" data-command="popout">
          <Icon name="lucide:external-link" />
          Open preview in a tab
        </button>
        <div class="pop-sep"></div>
        <ExportMenu suffix="-m" />
        <ViewMenu suffix="-m" />
        <ClearMenu suffix="-m" />
      </div>
    </div>

    <PresenceBar />
    <span
      id="role-badge"
      class="hb role-badge"
      hidden
      title="Only the owner and editors can save changes"
    >
      <Icon name="lucide:lock" />
      <span class="hidden lg:inline">View only</span>
    </span>
    <CollaborateDialog />

    <span class="hidden sm:inline sep"></span>
    <AccountMenu />
  </div>
</header>
