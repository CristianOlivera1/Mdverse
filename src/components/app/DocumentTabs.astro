---
import Icon from '../ui/Icon.astro';
---

<div class="flex min-w-0 flex-1 items-center gap-0.5" data-tabs-wrap>
  <button
    type="button"
    class="hb tabs-nav shrink-0"
    data-tabs-prev
    title="Scroll tabs left"
    aria-label="Scroll tabs left"
    hidden
  >
    <Icon name="lucide:chevron-left" />
  </button>
  <div
    class="seg w-fit max-w-[30vw] min-w-0 flex-none overflow-x-auto no-sb sm:max-w-[25vw] lg:max-w-[30vw]"
    id="editor-tabs"
    data-collection-tabs
    role="tablist"
    aria-label="Collections"
  ></div>
  <button
    type="button"
    class="hb tabs-nav shrink-0"
    data-tabs-next
    title="Scroll tabs right"
    aria-label="Scroll tabs right"
    hidden
  >
    <Icon name="lucide:chevron-right" />
  </button>
  <button
    type="button"
    class="hb shrink-0"
    data-command="new-collection"
    title="New collection"
    aria-label="New collection"
  >
    <Icon name="lucide:plus" />
  </button>
</div>

<div class="pop" data-pop="documents" role="dialog" aria-label="Documents" hidden>
  <p class="pop-label" data-documents-label>
    Documents
  </p>
  <div data-document-list role="listbox" aria-label="Documents in this collection"></div>
  <div class="pop-sep"></div>
  <button type="button" class="mi" data-command="new-document">
    <Icon name="lucide:file-plus" />
    New document
  </button>
  <button type="button" class="mi" data-document-move-open data-menu="move">
    <Icon name="lucide:list-tree" />
    Move to a collection…
  </button>
  <div class="pop" data-pop="move" role="dialog" aria-label="Move document" hidden>
    <p class="pop-label">Move this document to</p>
    <div data-move-list role="listbox" aria-label="Collections"></div>
  </div>
</div>
