---
import Icon from '../ui/Icon.astro';

interface Props {
  suffix?: string;
}

const { suffix = '' } = Astro.props as Props;
const menuName = `view${suffix}`;
const zoomId = `zoom-value${suffix}`;
---

<div>
  <button
    type="button"
    class="hb w-full justify-start!"
    data-menu={menuName}
    aria-haspopup="true"
    aria-expanded="false"
    title="View settings"
  >
    <Icon name="lucide:sliders-horizontal" />
    <span class="lg:inline">Settings</span>
  </button>
  <div class="pop" data-pop={menuName} hidden>
    <button
      type="button"
      class="mi"
      data-command="toggle-sync"
      data-keep
      title="Sync scroll between code and preview"
    >
      <Icon name="lucide:arrow-up-down" />
      Synced scroll<span class="sw"></span>
    </button>
    <div class="mi">
      <Icon name="lucide:zoom-in" />
      Text size
      <span class="ml-auto flex items-center gap-0.5">
        <button
          type="button"
          class="hb"
          data-command="zoom-out"
          data-keep
          title="Decrease font size"
          aria-label="Decrease font size"
        >
          <Icon name="lucide:minus" />
        </button>
        <button
          type="button"
          class="hb tabular-nums min-w-[46px]"
          data-command="zoom-reset"
          data-keep
          id={zoomId}
          title="Reset zoom"
        >
          100%
        </button>
        <button
          type="button"
          class="hb"
          data-command="zoom-in"
          data-keep
          title="Increase font size"
          aria-label="Increase font size"
        >
          <Icon name="lucide:plus" />
        </button>
      </span>
    </div>
    <div class="pop-sep sm:hidden"></div>
    <button type="button" class="mi sm:hidden" data-command="popout">
      <Icon name="lucide:external-link" />
      Open preview in a tab
    </button>
  </div>
</div>
