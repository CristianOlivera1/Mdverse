---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/ui/iconNames';

type FormatItem = readonly [command: string, icon: IconName, label: string, title: string];
type FormatGroup = readonly [name: string, items: readonly FormatItem[]];

const GROUPS: readonly FormatGroup[] = [
  [
    'Text',
    [
      ['bold', 'bold', 'Bold', 'Bold (Ctrl+B)'],
      ['italic', 'italic', 'Italic', 'Italic (Ctrl+I)'],
      ['strike', 'strikethrough', 'Strike', 'Strikethrough (Ctrl+Shift+X)'],
      ['code', 'code', 'Code', 'Inline code (Ctrl+E)'],
      ['link', 'link', 'Link', 'Link (Ctrl+K)'],
    ],
  ],
  [
    'Blocks',
    [
      ['heading', 'heading', 'Heading', 'Heading (cycles H1 → H3 → none)'],
      ['quote', 'quote', 'Quote', 'Blockquote'],
      ['ul', 'list', 'List', 'Bullet list'],
      ['ol', 'list-ordered', 'Numbered', 'Numbered list'],
      ['task', 'list-checks', 'Tasks', 'Task list'],
    ],
  ],
  [
    'Insert',
    [
      ['table', 'table', 'Table', 'Insert a table'],
      ['fence', 'braces', 'Block', 'Code block'],
      ['mermaid', 'workflow', 'Mermaid', 'Insert a Mermaid diagram'],
      ['hr', 'minus', 'Rule', 'Horizontal rule'],
    ],
  ],
  [
    'Editing',
    [
      ['undo', 'undo-2', 'Undo', 'Undo (Ctrl+Z)'],
      ['redo', 'redo-2', 'Redo', 'Redo (Ctrl+Y)'],
      ['find', 'search', 'Find', 'Find and replace (Ctrl+H)'],
    ],
  ],
];
---

<div class="fm">
  <button
    type="button"
    class="fm-btn"
    data-menu="format"
    aria-haspopup="true"
    aria-expanded="false"
    title="Markdown formatting"
  >
    <Icon name="type" />
    Format
    <Icon name="chevron-up" size={12} />
  </button>
  <div class="pop fm-pop" data-pop="format" data-r="format-pop" hidden>
    {GROUPS.map(([group, items]) => (
      <>
        <div class="pop-label">{group}</div>
        <div class="fgrid">
          {items.map(([command, icon, label, title]) => (
            <button type="button" class="ft" data-command={command} title={title}>
              <Icon name={icon} size={18} />
              <span>{label}</span>
            </button>
          ))}
        </div>
      </>
    ))}
  </div>
</div>
