---
import Avatar from '@/components/ui/Avatar.astro';
import Icon from '@/components/ui/Icon.astro';
import { toAccountSummary } from '@/lib/auth/account';

const account = toAccountSummary(Astro.locals.user, Astro.locals.profile);
---

{account ? (
  <div>
    <button
      type="button"
      class="hb"
      data-menu="account"
      aria-haspopup="true"
      aria-expanded="false"
      title={`${account.displayName} - your account`}
      aria-label={`Account: ${account.displayName}`}
    >
      <Avatar name={account.displayName} seed={account.toneSeed} size="sm" />
      <span class="hidden lg:inline max-w-[120px] truncate">{account.displayName}</span>
      <Icon name="lucide:chevron-down" class="hidden sm:inline size-4 opacity-70" />
    </button>

    <div class="pop" data-pop="account" hidden>
      <p class="pop-label truncate" title={account.email}>
        {account.displayName} · @{account.username}
      </p>
      <a href="/" class="mi">
        <Icon name="lucide:pencil-line" />
        Editor
      </a>
      <a href="/dashboard" class="mi">
        <Icon name="lucide:file-text" />
        Documents
      </a>
      <a href="/settings" class="mi">
        <Icon name="lucide:settings" />
        Profile
      </a>
      <div class="pop-sep"></div>
      <form method="POST" action="/auth/signout">
        <input type="hidden" name="next" value="/" />
        <button type="submit" class="mi danger">
          <Icon name="lucide:log-out" />
          Sign out
        </button>
      </form>
    </div>
  </div>
) : (
  <a href="/login" class="hb" title="Sign in to sync your documents">
    <span>Sign in</span>
  </a>
)}

<script>
  import { initMenus } from '../../lib/app/menus';

  initMenus();
</script>
