---
/**
 * Password field with a reveal button.
 *
 * `autocomplete="new-password"` switches on the policy hints (minimum length) and
 * lets the browser offer a generated password; the confirmation variant points
 * `data-password-confirm` at the first field, which the script in
 * `AuthShell.astro` turns into a native validity error — so the check still
 * applies if JavaScript never runs.
 */
import Icon from '@/components/ui/Icon.astro';
import {
  PASSWORD_HINT,
  PASSWORD_MAX_LENGTH,
  PASSWORD_MIN_LENGTH,
  PASSWORD_PATTERN,
} from '@/lib/auth/password';

interface Props {
  name?: string;
  id?: string;
  label: string;
  autocomplete?: 'current-password' | 'new-password';
  /** Id of the field this one must match (sign-up and reset screens). */
  matches?: string;
  /** Hint under the field. Defaults to the policy text on `new-password`; `null` hides it. */
  hint?: string | null;
}

const {
  name = 'password',
  id = name,
  label,
  autocomplete = 'current-password',
  matches,
  hint,
} = Astro.props;

const isNew = autocomplete === 'new-password';
const hintText = hint === null ? undefined : (hint ?? (isNew ? PASSWORD_HINT : undefined));
---

<div>
  <div class="flex items-baseline justify-between gap-2">
    <label for={id} class="block text-xs font-medium text-neutral-400">
      {label}
    </label>
    <slot name="label-extra" />
  </div>

  <div class="relative mt-1.5">
    <Icon
      name="lucide:lock"
      size={15}
      class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-neutral-500"
    />
    <input
      id={id}
      name={name}
      type="password"
      required
      autocomplete={autocomplete}
      minlength={isNew ? PASSWORD_MIN_LENGTH : undefined}
      maxlength={PASSWORD_MAX_LENGTH}
      pattern={isNew ? PASSWORD_PATTERN : undefined}
      title={isNew ? PASSWORD_HINT : undefined}
      data-password-confirm={matches}
      class="w-full rounded-lg border border-neutral-800 bg-neutral-950 pl-9 pr-10 py-2 text-sm text-neutral-100 placeholder:text-neutral-600 focus:border-neutral-600 focus:outline-none disabled:opacity-50"
    />
    <button
      type="button"
      data-password-toggle={id}
      aria-controls={id}
      aria-pressed="false"
      class="absolute right-1.5 top-1/2 -translate-y-1/2 flex h-7 w-7 items-center justify-center rounded-md text-neutral-500 hover:text-neutral-200 focus-visible:outline focus-visible:outline-1 focus-visible:outline-sky-500"
    >
      <Icon name="lucide:eye" size={15} class="pw-show" />
      <Icon name="lucide:eye-off" size={15} class="pw-hide" />
      <span class="sr-only">Show password</span>
    </button>
  </div>

  {hintText && <p class="mt-1.5 text-[11px] leading-relaxed text-neutral-500">{hintText}</p>}
</div>
