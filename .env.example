# ─────────────────────────────────────────────────────────────
# Mdverse - environment variables (template)
# Copy this file to `.env` for local development.
# Only variables prefixed with PUBLIC_ reach the browser.
# ─────────────────────────────────────────────────────────────

# ── Supabase (client + server) ───────────────────────────────
PUBLIC_SUPABASE_URL=https://x.x.x.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=x.x.x

# ── Server-only secret - never expose to the browser ─────────
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# ── Site ─────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321

# ── Local CLI / CI only (do not commit real values) ──────────
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=sbp_xxx
SUPABASE_DB_PASSWORD=xxx

# ── Resend (transactional email) ─────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Must be a verified domain in Resend: https://resend.com/domains
# Format: "Mdverse <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=Mdverse <noreply@yourdomain.com>
# Optional reply-to address
RESEND_REPLY_TO=
